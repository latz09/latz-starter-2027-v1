# .env.example
# Copy to .env.local (new-client.mjs does this for you and fills in the
# Sanity values). Add the same variables in Vercel → Settings → Environment
# Variables. .env* files are gitignored. Never commit real values.

# ── Sanity ─────────────────────────────────────────────────────────────────
# Leave the project ID empty and the site runs on placeholder content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Viewer role: draft mode / Presentation tool reads.
SANITY_VIEWER_TOKEN=
# Editor role: contact form writes submissions to Sanity. Server only.
SANITY_API_TOKEN=

# ── Email (contact form) ───────────────────────────────────────────────────
RESEND_API_KEY=
# The inbox that receives new-inquiry notifications.
CLIENT_EMAIL=

# ── Site ───────────────────────────────────────────────────────────────────
# Production URL with https, no trailing slash. Used by next-sitemap.
# Must match Studio → SEO Settings → Site URL.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
